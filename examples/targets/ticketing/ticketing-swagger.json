  "components": {
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "name"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword"
        ]
      },
      "UpdateNotificationPreferenceRequest": {
        "type": "object",
        "properties": {
          "emailOptIn": {
            "type": "boolean"
          }
        },
        "required": [
          "emailOptIn"
        ]
      },
      "EventUpsertRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "venue": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "CONCERT",
              "MUSICAL",
              "PLAY",
              "CLASSIC",
              "SPORTS",
              "EXHIBITION",
              "FESTIVAL",
              "ETC"
            ]
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "openAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPCOMING",
              "OPEN",
              "CLOSED"
            ]
          }
        },
        "required": [
          "title",
          "venue",
          "category",
          "startAt",
          "openAt",
          "status"
        ]
      },
      "SeatBulkCreateRequest": {
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeatBlockRequest"
            }
          }
        },
        "required": [
          "blocks"
        ]
      },
      "SeatBlockRequest": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "maxLength": 50
          },
          "grade": {
            "type": "string",
            "maxLength": 20
          },
          "price": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          "seatsPerRow": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "section",
          "grade",
          "price",
          "rows",
          "seatsPerRow"
        ]
      },
      "SeatPriceUpdateRequest": {
        "type": "object",
        "properties": {
          "price": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "price"
        ]
      },
      "KopisImportRequest": {
        "type": "object",
        "properties": {
          "genre": {
            "type": "string",
            "enum": [
              "PLAY",
              "MUSICAL",
              "CLASSIC",
              "KOREAN_MUSIC",
              "POPULAR_MUSIC",
              "DANCE"
            ]
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "genre"
        ]
      },
      "ReviewCreateRequest": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 5
          },
          "content": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "rating",
          "content"
        ]
      },
      "WishlistAddRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "eventId"
        ]
      },
      "CouponCreateRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{3,30}$"
          },
          "discountType": {
            "type": "string",
            "enum": [
              "FLAT",
              "PERCENT"
            ]
          },
          "discountValue": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validTo": {
            "type": "string",
            "format": "date-time"
          },
          "maxUses": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 1
          }
        },
        "required": [
          "code",
          "discountType",
          "discountValue",
          "validFrom",
          "validTo",
          "maxUses"
        ]
      },
      "OrderCreateRequest": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "reservationId"
        ]
      },
      "PaymentRequest": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          }
        },
        "required": [
          "paymentId"
        ]
      },
      "ApplyCouponRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 30
          }
        },
        "required": [
          "code"
        ]
      },
      "ApplyPointsRequest": {
        "type": "object",
        "properties": {
          "points": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "points"
        ]
      },
      "ScanRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "TransferRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyIdentityRequest": {
        "type": "object",
        "properties": {
          "agreed": {
            "type": "boolean"
          }
        }
      },
      "ReservationCreateRequest": {
        "type": "object",
        "properties": {
          "seatId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "seatId"
        ]
      },
      "QueueEnterRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
